{
  "expo": {
    "name": "Mijote",
    "slug": "mijote",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mijote",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "ci.mijote.app"
    },
    "android": {
      "package": "ci.mijote.app",
      "adaptiveIcon": {
        "backgroundColor": "#3A1C2E",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3A1C2E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}